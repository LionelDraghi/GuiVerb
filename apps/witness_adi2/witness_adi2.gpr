with "adi.gpr";

--  GuiVerb Adi2 witness probe application.
project Witness_Adi2 is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("witness_adi2.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-g", "-gnata");
   end Compiler;

end Witness_Adi2;
