with "config/guiverb_witness_config.gpr";
with "gtkada";

project Guiverb_Witness is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Guiverb_Witness_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("witness.adb");

   package Compiler is
      for Default_Switches ("Ada")
        use Guiverb_Witness_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Guiverb_Witness;
