# The reference application's Gnoga projection (sub-crate with its own
# dependencies). Build outputs are generated locally, never committed.

.SILENT:

.PHONY: build clean

build:
	echo "--- witness_gnoga build (Gnoga projection)"
	alr build
	echo "OK"

clean:
	alr clean
