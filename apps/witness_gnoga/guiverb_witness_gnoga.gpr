with "config/guiverb_witness_gnoga_config.gpr";

project Guiverb_Witness_Gnoga is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Guiverb_Witness_Gnoga_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("witness_gnoga.adb");

   package Compiler is
      for Default_Switches ("Ada")
        use ("-gnat2022", "-g", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Guiverb_Witness_Gnoga;
